# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fitness?retryWrites=true&w=majority

# Secret used to sign login tokens (32+ chars). Generate: openssl rand -hex 32
JWT_SECRET=

# Your deployed front-end URL (no trailing slash). http://localhost:3000 is always allowed.
CLIENT_ORIGIN=https://fitness-tracker-app-1-6eco.onrender.com

# Optional: enables "Sign in with Google" (same Client ID as the front-end)
GOOGLE_CLIENT_ID=

PORT=5002
